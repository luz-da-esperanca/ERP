{
  "name": "@erp/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "dev:web": "pnpm --filter @erp/web dev",
    "dev:api": "pnpm dev",
    "build": "pnpm typecheck && pnpm build:api",
    "build:api": "prisma generate && node build.mjs",
    "typecheck": "pnpm db:generate && pnpm typecheck:api && pnpm -r typecheck",
    "lint": "eslint src test apps packages --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm db:generate && vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap": "node --env-file-if-exists=.env --import tsx src/bootstrap.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/seed.ts",
    "format": "prettier --write src test apps packages *.json *.mjs *.ts pnpm-workspace.yaml",
    "format:check": "prettier --check src test apps packages *.json *.mjs *.ts pnpm-workspace.yaml",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck:api": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bcrypt": "6.0.0",
    "@types/node": "24.19.1",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@erp/contracts": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "6.0.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "redis": "6.3.0",
    "zod": "4.6.5"
  }
}
