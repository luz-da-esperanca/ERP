{
  "name": "@erp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "prisma generate && node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap": "node --env-file-if-exists=.env --import tsx src/bootstrap.ts"
  },
  "dependencies": {
    "@erp/contracts": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "6.0.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "redis": "6.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "esbuild": "0.28.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15"
  }
}
