{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": ["src/server", "src/modules"],
  "exclude": ["node_modules", "dist", "test", "src/client"]
}
