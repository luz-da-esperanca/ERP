generator client {
  provider = "prisma-client"
  output   = "../src/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model StockCategory {
  id        String              @id @db.Uuid
  code      String              @unique @default(dbgenerated("next_stock_catalog_code('CAT'::text, 'stock_category_code_seq'::regclass)")) @db.VarChar(23)
  name      String              @db.VarChar(150)
  isActive  Boolean             @map("is_active")
  version   Int
  createdAt DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @map("updated_at") @db.Timestamptz(3)
  revisions StockItemRevision[]

  @@index([name, id])
  @@map("stock_categories")
}

model StockUnit {
  id        String              @id @db.Uuid
  code      String              @unique @default(dbgenerated("next_stock_catalog_code('UNIT'::text, 'stock_unit_code_seq'::regclass)")) @db.VarChar(24)
  name      String              @db.VarChar(150)
  precision Int
  isActive  Boolean             @map("is_active")
  version   Int
  createdAt DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @map("updated_at") @db.Timestamptz(3)
  revisions StockItemRevision[]

  @@index([name, id])
  @@map("stock_units")
}

model StockSize {
  id        String              @id @db.Uuid
  code      String              @unique @default(dbgenerated("next_stock_catalog_code('SIZE'::text, 'stock_size_code_seq'::regclass)")) @db.VarChar(24)
  name      String              @db.VarChar(150)
  isActive  Boolean             @map("is_active")
  version   Int
  createdAt DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @map("updated_at") @db.Timestamptz(3)
  revisions StockItemRevision[]

  @@index([name, id])
  @@map("stock_sizes")
}

model StockItem {
  id        String              @id @db.Uuid
  code      String              @unique @default(dbgenerated("next_stock_catalog_code('ITEM'::text, 'stock_item_code_seq'::regclass)")) @db.VarChar(24)
  version   Int
  createdAt DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @map("updated_at") @db.Timestamptz(3)
  revisions StockItemRevision[]

  @@map("stock_items")
}

model StockItemRevision {
  id            String        @id @db.Uuid
  itemId        String        @map("item_id") @db.Uuid
  version       Int
  name          String        @db.VarChar(150)
  categoryId    String        @map("category_id") @db.Uuid
  categoryName  String        @map("category_name") @db.VarChar(150)
  unitId        String        @map("unit_id") @db.Uuid
  unitName      String        @map("unit_name") @db.VarChar(150)
  unitPrecision Int           @map("unit_precision")
  sizeId        String?       @map("size_id") @db.Uuid
  sizeName      String?       @map("size_name") @db.VarChar(150)
  isActive      Boolean       @map("is_active")
  recordedAt    DateTime      @map("recorded_at") @db.Timestamptz(3)
  item          StockItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  category      StockCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit          StockUnit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  size          StockSize?    @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@unique([itemId, version])
  @@index([categoryId])
  @@index([unitId])
  @@index([sizeId])
  @@map("stock_item_revisions")
}

model User {
  id            String                  @id @db.Uuid
  login         String                  @unique @db.VarChar(120)
  displayName   String                  @map("display_name") @db.VarChar(150)
  passwordHash  String                  @map("password_hash")
  status        String                  @db.VarChar(32)
  version       Int                     @default(1)
  createdAt     DateTime                @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                @map("updated_at") @db.Timestamptz(3)
  deactivatedAt DateTime?               @map("deactivated_at") @db.Timestamptz(3)
  profiles      UserProfileAssignment[]
  sessions      Session[]

  @@index([status])
  @@map("users")
}

model UserProfileAssignment {
  userId     String   @map("user_id") @db.Uuid
  profile    String   @db.VarChar(48)
  assignedAt DateTime @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, profile])
  @@index([profile])
  @@map("user_profile_assignments")
}

model Session {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  issuedAt       DateTime  @map("issued_at") @db.Timestamptz(3)
  lastActivityAt DateTime  @map("last_activity_at") @db.Timestamptz(3)
  idleExpiresAt  DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LoginAttemptState {
  login          String    @id @db.VarChar(120)
  failedAttempts Int       @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)

  @@map("login_attempt_states")
}

model Institute {
  id          String             @id @db.Uuid
  code        String             @unique @db.VarChar(48)
  name        String             @unique @db.VarChar(120)
  description String             @db.VarChar(500)
  active      Boolean            @default(true)
  projects    ProjectInstitute[]

  @@map("institutes")
}

model Project {
  id          String             @id @db.Uuid
  name        String             @db.VarChar(150)
  description String?            @db.VarChar(1000)
  startDate   String             @map("start_date") @db.VarChar(10)
  endDate     String?            @map("end_date") @db.VarChar(10)
  status      String             @db.VarChar(32)
  version     Int                @default(1)
  createdAt   DateTime           @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @map("updated_at") @db.Timestamptz(3)
  closedAt    DateTime?          @map("closed_at") @db.Timestamptz(3)
  institutes  ProjectInstitute[]

  @@index([status])
  @@index([name])
  @@map("projects")
}

model ProjectInstitute {
  projectId   String    @map("project_id") @db.Uuid
  instituteId String    @map("institute_id") @db.Uuid
  linkedAt    DateTime  @map("linked_at") @db.Timestamptz(3)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Restrict)

  @@id([projectId, instituteId])
  @@index([instituteId])
  @@map("project_institutes")
}

model AuditEntryRecord {
  id          String   @id @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  factDate    String   @map("fact_date") @db.VarChar(10)
  recordedAt  DateTime @map("recorded_at") @db.Timestamptz(3)
  entityType  String   @map("entity_type") @db.VarChar(64)
  entityId    String   @map("entity_id") @db.Uuid
  action      String   @db.VarChar(48)
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  reason      String?  @db.VarChar(1000)
  operationId String?  @map("operation_id") @db.Uuid

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_entries")
}

model OperationConfirmation {
  secretHash    String?  @map("secret_hash")
  operationType String   @map("operation_type") @db.VarChar(64)
  actorId       String   @map("actor_id") @db.Uuid
  operationId   String   @map("operation_id") @db.Uuid
  payloadDigest String   @map("payload_digest") @db.VarChar(64)
  statusCode    Int      @map("status_code")
  responseBody  Json     @map("response_body")
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)

  @@id([operationType, actorId, operationId])
  @@map("operation_confirmations")
}
