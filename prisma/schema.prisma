generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ActorType {
  USER
  SYSTEM_BOOTSTRAP
}

enum AuditAction {
  CREATE
  UPDATE
  ACTIVATE
  DEACTIVATE
  PASSWORD_CHANGE
  PASSWORD_RESET
  CLOSE
  CORRECT
  CANCEL
  INVALIDATE
  MERGE
}

model UserAccount {
  id                          String                       @id @default(uuid()) @db.Uuid
  login                       String                       @unique @db.VarChar(100)
  displayName                 String                       @db.VarChar(200)
  passwordHash                String
  active                      Boolean                      @default(true)
  mustChangePassword          Boolean                      @default(true)
  authVersion                 Int                          @default(1)
  revision                    Int                          @default(1)
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(3)
  roles                       RoleAssignment[]
  operations                  OperationRecord[]
  auditEntries                AuditEntry[]
  decisions                   FeatureDecision[]
  resolvedRegistrationIssues  DataQualityIssue[]
  createdProjects             Project[]                    @relation("ProjectCreator")
  updatedProjects             Project[]                    @relation("ProjectUpdater")
  createdActivities           Activity[]                   @relation("ActivityCreator")
  updatedActivities           Activity[]                   @relation("ActivityUpdater")
  responsibleActivities       Activity[]                   @relation("ActivityResponsible")
  createdEnrollments          ParticipantEnrollment[]      @relation("EnrollmentCreator")
  updatedEnrollments          ParticipantEnrollment[]      @relation("EnrollmentUpdater")
  recordedSessions            ActivitySession[]            @relation("SessionRecorder")
  executedSessions            ActivitySession[]            @relation("SessionResponsible")
  recordedAttendances         Attendance[]
  coverageDeclarations        AttendanceCoverage[]
  fieldSelections             FieldSelectionVersion[]
  recordedSocialForms         SocialForm[]
  recordedAcknowledgements    Acknowledgement[]
  eligibilityPolicies         EligibilityPolicy[]
  eligibilityAssessments      EligibilityAssessment[]
  identityMerges              IdentityMerge[]
  registrationFieldSelections RegistrationFieldSelection[]
}

model Role {
  code        String           @id @db.VarChar(40)
  label       String           @db.VarChar(100)
  assignments RoleAssignment[]
}

model RoleAssignment {
  userId   String      @db.Uuid
  roleCode String      @db.VarChar(40)
  user     UserAccount @relation(fields: [userId], references: [id], onDelete: Restrict)
  role     Role        @relation(fields: [roleCode], references: [code], onDelete: Restrict)

  @@id([userId, roleCode])
}

model OperationRecord {
  id                 String         @id @default(uuid()) @db.Uuid
  type               String         @db.VarChar(100)
  key                String         @db.Uuid
  actorType          ActorType
  actorId            String?        @db.Uuid
  actor              UserAccount?   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fingerprintKeyId   String?        @db.VarChar(100)
  requestFingerprint String         @db.VarChar(64)
  resultReference    Json?
  completedAt        DateTime?      @db.Timestamptz(3)
  entries            AuditEntry[]
  identityMerge      IdentityMerge?

  @@unique([type, key])
}

model AuditEntry {
  id             String          @id @default(uuid()) @db.Uuid
  operationId    String          @db.Uuid
  operation      OperationRecord @relation(fields: [operationId], references: [id], onDelete: Restrict)
  entityType     String          @db.VarChar(100)
  entityId       String          @db.Uuid
  revision       Int
  action         AuditAction
  actorType      ActorType
  actorId        String?         @db.Uuid
  actor          UserAccount?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  recordedAt     DateTime        @default(now()) @db.Timestamptz(3)
  occurredAt     DateTime?       @db.Timestamptz(3)
  before         Json?
  after          Json
  reason         String?         @db.VarChar(2000)
  classification String          @db.VarChar(100)

  @@unique([entityType, entityId, revision])
  @@index([entityType, recordedAt, id])
}

model FeatureDecision {
  id                String      @unique @default(uuid()) @db.Uuid
  code              String      @id @db.VarChar(100)
  enabled           Boolean
  decisionReference String      @db.VarChar(2000)
  decidedAt         DateTime    @db.Timestamptz(3)
  decidedBy         String      @db.Uuid
  actor             UserAccount @relation(fields: [decidedBy], references: [id], onDelete: Restrict)
  revision          Int         @default(1)
}

model Family {
  id            String             @id @default(uuid()) @db.Uuid
  code          BigInt             @unique @default(autoincrement())
  referenceName String?            @db.VarChar(200)
  address       String?            @db.VarChar(500)
  neighborhood  String?            @db.VarChar(200)
  postalCode    String?            @db.VarChar(8)
  location      String?            @db.VarChar(10)
  contactPhone  String?            @db.VarChar(50)
  revision      Int                @default(1)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  mergedIntoId  String?            @db.Uuid
  mergedInto    Family?            @relation("FamilyAliases", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  aliases       Family[]           @relation("FamilyAliases")
  memberships   FamilyMembership[]
  attendances   Attendance[]
  nameSearch    String             @default("") @db.VarChar(200)
  socialForms   SocialForm[]

  addressSearch          String                  @default("") @db.VarChar(500)
  eligibilityAssessments EligibilityAssessment[]
}

model Person {
  id                   String                  @id @default(uuid()) @db.Uuid
  name                 String                  @db.VarChar(200)
  birthDate            DateTime?               @db.Date
  sex                  String?                 @db.VarChar(100)
  cpf                  String?                 @db.VarChar(11)
  rg                   String?                 @db.VarChar(30)
  occupation           String?                 @db.VarChar(100)
  educationLevel       String?                 @db.VarChar(100)
  contactPhone         String?                 @db.VarChar(50)
  revision             Int                     @default(1)
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)
  mergedIntoId         String?                 @db.Uuid
  mergedInto           Person?                 @relation("PersonAliases", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  aliases              Person[]                @relation("PersonAliases")
  memberships          FamilyMembership[]
  nameSearch           String                  @default("") @db.VarChar(200)
  sizeProfile          SizeProfile?
  enrollments          ParticipantEnrollment[]
  attendances          Attendance[]
  formMembers          FormMember[]
  acknowledgements     Acknowledgement[]
  eligibilityEvidences EligibilityEvidence[]

  @@index([cpf])
}

model SizeProfile {
  personId     String    @id @db.Uuid
  person       Person    @relation(fields: [personId], references: [id], onDelete: Restrict)
  shoeSize     String?   @db.VarChar(30)
  clothingSize String?   @db.VarChar(30)
  informedOn   DateTime? @db.Date
  revision     Int       @default(1)
}

model DataQualityIssue {
  id           String       @id @default(uuid()) @db.Uuid
  entityType   String       @db.VarChar(20)
  entityId     String       @db.Uuid
  kind         String       @db.VarChar(40)
  candidateIds String[]     @db.Uuid
  fieldKeys    String[]
  identifiedAt DateTime     @default(now()) @db.Timestamptz(3)
  resolvedAt   DateTime?    @db.Timestamptz(3)
  resolution   String?      @db.VarChar(20)
  resolvedBy   String?      @db.Uuid
  resolver     UserAccount? @relation(fields: [resolvedBy], references: [id], onDelete: Restrict)
  reason       String?      @db.VarChar(1000)
  revision     Int          @default(1)

  @@index([entityType, entityId, kind])
}

model RegistrationFieldSelection {
  id                String      @id @default(uuid()) @db.Uuid
  version           Int         @unique
  personFields      String[]
  familyFields      String[]
  decisionReference String      @db.VarChar(1000)
  recordedAt        DateTime    @db.Timestamptz(3)
  recordedBy        String      @db.Uuid
  actor             UserAccount @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
}

model FamilyMembership {
  id                      String             @id @default(uuid()) @db.Uuid
  personId                String             @db.Uuid
  person                  Person             @relation(fields: [personId], references: [id], onDelete: Restrict)
  familyId                String             @db.Uuid
  family                  Family             @relation(fields: [familyId], references: [id], onDelete: Restrict)
  relationshipToReference String?            @db.VarChar(100)
  isReference             Boolean            @default(false)
  validFrom               DateTime           @db.Timestamptz(3)
  validUntil              DateTime?          @db.Timestamptz(3)
  revision                Int                @default(1)
  supersededById          String?            @db.Uuid
  supersededBy            FamilyMembership?  @relation("MembershipSupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  superseded              FamilyMembership[] @relation("MembershipSupersession")
  attendances             Attendance[]
  formMembers             FormMember[]

  @@index([personId, validFrom])
  @@index([familyId, validFrom])
}

model FieldSelectionVersion {
  id                String       @id @default(uuid()) @db.Uuid
  version           Int          @unique
  recordedAt        DateTime     @db.Timestamptz(3)
  recordedBy        String       @db.Uuid
  actor             UserAccount  @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  decisionReference String       @db.VarChar(2000)
  fields            Json
  socialForms       SocialForm[]
}

model SocialFormOption {
  id       String  @id @default(uuid()) @db.Uuid
  fieldKey String  @db.VarChar(100)
  code     String  @db.VarChar(100)
  label    String  @db.VarChar(200)
  active   Boolean @default(true)
  isOther  Boolean @default(false)
  revision Int     @default(1)

  @@unique([fieldKey, code])
}

model SocialForm {
  id                      String                @id @default(uuid()) @db.Uuid
  familyId                String                @db.Uuid
  family                  Family                @relation(fields: [familyId], references: [id], onDelete: Restrict)
  version                 Int
  previousVersionId       String?               @unique @db.Uuid
  previousVersion         SocialForm?           @relation("SocialFormVersions", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersion             SocialForm?           @relation("SocialFormVersions")
  correctionOfFormId      String?               @db.Uuid
  correctionOfForm        SocialForm?           @relation("SocialFormCorrections", fields: [correctionOfFormId], references: [id], onDelete: Restrict)
  corrections             SocialForm[]          @relation("SocialFormCorrections")
  referenceMemberId       String?               @db.Uuid
  referenceMember         FormMember?           @relation("FormReference", fields: [referenceMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  occurredAt              DateTime              @db.Timestamptz(3)
  recordedAt              DateTime              @db.Timestamptz(3)
  recordedBy              String                @db.Uuid
  actor                   UserAccount           @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  fieldSelectionVersionId String                @db.Uuid
  fieldSelection          FieldSelectionVersion @relation(fields: [fieldSelectionVersionId], references: [id], onDelete: Restrict)
  familySnapshot          Json
  blocks                  Json
  reason                  String?               @db.VarChar(1000)
  members                 FormMember[]
  acknowledgement         Acknowledgement?

  @@unique([familyId, version])
  @@index([familyId, recordedAt])
}

model FormMember {
  id                 String           @id @default(uuid()) @db.Uuid
  socialFormId       String           @db.Uuid
  socialForm         SocialForm       @relation(fields: [socialFormId], references: [id], onDelete: Restrict)
  personId           String           @db.Uuid
  person             Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  membershipId       String           @db.Uuid
  membership         FamilyMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  membershipRevision Int
  payload            Json
  referenceFor       SocialForm[]     @relation("FormReference")

  @@unique([socialFormId, personId])
}

model Acknowledgement {
  id                String      @id @default(uuid()) @db.Uuid
  socialFormId      String      @unique @db.Uuid
  socialForm        SocialForm  @relation(fields: [socialFormId], references: [id], onDelete: Restrict)
  referencePersonId String      @db.Uuid
  person            Person      @relation(fields: [referencePersonId], references: [id], onDelete: Restrict)
  method            String      @db.VarChar(100)
  acknowledgedOn    DateTime    @db.Date
  recordedAt        DateTime    @db.Timestamptz(3)
  recordedBy        String      @db.Uuid
  actor             UserAccount @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  revision          Int         @default(1)
}

model Institute {
  id       String    @id @default(uuid()) @db.Uuid
  code     String    @unique @db.VarChar(40)
  name     String    @db.VarChar(200)
  active   Boolean   @default(true)
  revision Int       @default(1)
  projects Project[]
}

model ServiceType {
  id         String     @id @default(uuid()) @db.Uuid
  code       String     @unique @db.VarChar(40)
  name       String     @db.VarChar(200)
  active     Boolean    @default(true)
  revision   Int        @default(1)
  activities Activity[]
}

model Project {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @db.VarChar(200)
  nameSearch  String      @db.VarChar(200)
  description String?     @db.VarChar(4000)
  instituteId String      @db.Uuid
  institute   Institute   @relation(fields: [instituteId], references: [id], onDelete: Restrict)
  startsOn    DateTime?   @db.Date
  endsOn      DateTime?   @db.Date
  status      String      @default("ACTIVE") @db.VarChar(10)
  closedAt    DateTime?   @db.Timestamptz(3)
  revision    Int         @default(1)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  createdBy   String      @db.Uuid
  creator     UserAccount @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy   String      @db.Uuid
  updater     UserAccount @relation("ProjectUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  activities  Activity[]
}

model Activity {
  id                   String                  @id @default(uuid()) @db.Uuid
  projectId            String                  @db.Uuid
  project              Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name                 String                  @db.VarChar(200)
  nameSearch           String                  @db.VarChar(200)
  nature               String                  @db.VarChar(10)
  serviceTypeId        String?                 @db.Uuid
  serviceType          ServiceType?            @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  plannedSchedule      String?                 @db.VarChar(500)
  responsibleId        String?                 @db.Uuid
  responsibleAccount   UserAccount?            @relation("ActivityResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  status               String                  @default("ACTIVE") @db.VarChar(10)
  closedAt             DateTime?               @db.Timestamptz(3)
  revision             Int                     @default(1)
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)
  createdBy            String                  @db.Uuid
  creator              UserAccount             @relation("ActivityCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy            String                  @db.Uuid
  updater              UserAccount             @relation("ActivityUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  enrollments          ParticipantEnrollment[]
  sessions             ActivitySession[]
  coverageDeclarations AttendanceCoverage[]
}

model ParticipantEnrollment {
  id             String                  @id @default(uuid()) @db.Uuid
  activityId     String                  @db.Uuid
  activity       Activity                @relation(fields: [activityId], references: [id], onDelete: Restrict)
  personId       String                  @db.Uuid
  person         Person                  @relation(fields: [personId], references: [id], onDelete: Restrict)
  validFrom      DateTime                @db.Timestamptz(3)
  validUntil     DateTime?               @db.Timestamptz(3)
  supersededById String?                 @db.Uuid
  supersededBy   ParticipantEnrollment?  @relation("EnrollmentSupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  superseded     ParticipantEnrollment[] @relation("EnrollmentSupersession")
  revision       Int                     @default(1)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)
  createdBy      String                  @db.Uuid
  creator        UserAccount             @relation("EnrollmentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy      String                  @db.Uuid
  updater        UserAccount             @relation("EnrollmentUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([activityId, validFrom])
  @@index([personId, validFrom])
}

model ActivitySession {
  id            String       @id @default(uuid()) @db.Uuid
  activityId    String       @db.Uuid
  activity      Activity     @relation(fields: [activityId], references: [id], onDelete: Restrict)
  responsibleId String       @db.Uuid
  responsible   UserAccount  @relation("SessionResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  occurredAt    DateTime     @db.Timestamptz(3)
  recordedAt    DateTime     @default(now()) @db.Timestamptz(3)
  recordedBy    String       @db.Uuid
  recorder      UserAccount  @relation("SessionRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  status        String       @default("COMPLETED") @db.VarChar(10)
  revision      Int          @default(1)
  attendances   Attendance[]

  @@index([activityId, occurredAt])
}

model Attendance {
  id                 String           @id @default(uuid()) @db.Uuid
  sessionId          String           @db.Uuid
  session            ActivitySession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  personId           String           @db.Uuid
  person             Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  familyId           String           @db.Uuid
  family             Family           @relation(fields: [familyId], references: [id], onDelete: Restrict)
  membershipId       String           @db.Uuid
  membership         FamilyMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  membershipRevision Int
  status             String           @db.VarChar(10)
  recordedAt         DateTime         @default(now()) @db.Timestamptz(3)
  recordedBy         String           @db.Uuid
  recorder           UserAccount      @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  revision           Int              @default(1)
  supersededById     String?          @db.Uuid
  supersededBy       Attendance?      @relation("AttendanceSupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  superseded         Attendance[]     @relation("AttendanceSupersession")

  @@index([personId, sessionId])
  @@index([membershipId])
}

model AttendanceCoverage {
  id                 String      @id @default(uuid()) @db.Uuid
  activityId         String      @db.Uuid
  activity           Activity    @relation(fields: [activityId], references: [id], onDelete: Restrict)
  periodStart        DateTime    @db.Date
  periodEndExclusive DateTime    @db.Date
  declaredBy         String      @db.Uuid
  declarer           UserAccount @relation(fields: [declaredBy], references: [id], onDelete: Restrict)
  declaredAt         DateTime    @default(now()) @db.Timestamptz(3)
  sourceVersions     Json
  invalidatedPeriods Json        @default("[]")
  revision           Int         @default(1)

  @@index([activityId, periodStart, periodEndExclusive])
}

model EligibilityPolicy {
  id                String                  @id @default(uuid()) @db.Uuid
  effectiveFrom     DateTime                @unique @db.Date
  definition        Json
  decisionReference String                  @db.VarChar(2000)
  reason            String                  @db.VarChar(1000)
  recordedAt        DateTime                @default(now()) @db.Timestamptz(3)
  recordedBy        String                  @db.Uuid
  recorder          UserAccount             @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  assessments       EligibilityAssessment[]
}

model EligibilityAssessment {
  id                String                @id @default(uuid()) @db.Uuid
  familyId          String                @db.Uuid
  family            Family                @relation(fields: [familyId], references: [id], onDelete: Restrict)
  referenceDate     DateTime              @db.Date
  evaluatedAt       DateTime              @db.Timestamptz(3)
  policyId          String?               @db.Uuid
  policy            EligibilityPolicy?    @relation(fields: [policyId], references: [id], onDelete: Restrict)
  status            String                @db.VarChar(10)
  pendingReasons    String[]
  explanation       Json
  sourceFingerprint String                @db.VarChar(64)
  requestedBy       String                @db.Uuid
  requester         UserAccount           @relation(fields: [requestedBy], references: [id], onDelete: Restrict)
  evidences         EligibilityEvidence[]

  @@index([familyId, referenceDate])
}

model EligibilityEvidence {
  id                   String                @id @default(uuid()) @db.Uuid
  assessmentId         String                @db.Uuid
  assessment           EligibilityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  position             Int
  personId             String                @db.Uuid
  person               Person                @relation(fields: [personId], references: [id], onDelete: Restrict)
  membershipIds        String[]              @db.Uuid
  activityIds          String[]              @db.Uuid
  periodStart          DateTime              @db.Date
  periodEndExclusive   DateTime              @db.Date
  sessionCount         Int
  presenceCount        Int
  absenceCount         Int
  unrecordedCount      Int
  rateLowerBasisPoints Int?
  rateUpperBasisPoints Int?
  coverageComplete     Boolean
  status               String                @db.VarChar(10)
  pendingReason        String?               @db.VarChar(40)
  sourceVersions       Json

  @@unique([assessmentId, position])
}

model IdentityMerge {
  id          String          @id @default(uuid()) @db.Uuid
  entityType  String          @db.VarChar(20)
  sourceId    String          @unique @db.Uuid
  targetId    String          @db.Uuid
  recordedAt  DateTime        @default(now()) @db.Timestamptz(3)
  recordedBy  String          @db.Uuid
  recorder    UserAccount     @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  reason      String          @db.VarChar(1000)
  operationId String          @unique @db.Uuid
  operation   OperationRecord @relation(fields: [operationId], references: [id], onDelete: Restrict)
  resolution  Json

  @@index([targetId])
}
