NODE_ENV=development
HOST=127.0.0.1
TRUST_PROXY_ADDRESSES=
PORT=3001
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=America/Fortaleza
DATA_MODE=SYNTHETIC
DATABASE_URL=postgresql://erp:erp_local_only@localhost:5432/erp
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=erp:
# Generate independent keys with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
JWT_SECRET_BASE64=
JWT_ISSUER=erp-social
JWT_AUDIENCE=erp-web
# Keep old keys available when rotating the current key ID.
OPERATION_HMAC_CURRENT_KEY_ID=v1
OPERATION_HMAC_KEYS_JSON={"v1":""}
# Optional while protected social blocks remain disabled. Generate a third, independent 32-byte key.
# Preserve historical keys when rotating the current key ID.
SOCIAL_FORM_CURRENT_KEY_ID=
SOCIAL_FORM_KEYS_JSON={}
BCRYPT_COST=12
COOKIE_SECURE=false
SESSION_IDLE_SECONDS=1800
SESSION_MAX_SECONDS=28800
LOGIN_MAX_FAILURES=5
LOGIN_BLOCK_SECONDS=900
LOGIN_IP_MAX_ATTEMPTS=50
LOGIN_IP_WINDOW_SECONDS=900
