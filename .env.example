# Local development only. Configure a dedicated database and never use production data.
DATABASE_URL=postgresql://erp:erp-local-only@127.0.0.1:5432/erp?schema=public
HOST=127.0.0.1
PORT=3000
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp-local-only
POSTGRES_DB=erp
POSTGRES_PORT=5432

# Proposed technical settings under LAC-10; institutional approval remains pending.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_SECONDS=900
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
# Enable for shared HTTPS deployments; NODE_ENV=production always enforces Secure cookies.
AUTH_COOKIE_SECURE=false
